<%- include('../partials/head', { title: 'השארת פרטים', shell: 'public' }) %>
<% if (!embed) { %><div class="hero"><div class="big"><%= brand %></div><p class="muted">ספרו לנו על האירוע ונחזור אליכם בהקדם</p></div><% } %>
<% if (sent) { %>
  <div class="card" style="text-align:center"><div class="big" style="font-size:2rem">🎶</div><h2>תודה! קיבלנו את הפרטים</h2><p class="muted">נחזור אליכם בהקדם.</p></div>
<% } else { %>
<% if (error) { %><div class="flash err"><%= error %></div><% } %>
<form method="post" action="/apply" class="card">
  <input type="hidden" name="embed" value="<%= embed ? '1' : '' %>">
  <div class="hp" aria-hidden="true"><label>אתר<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
  <div class="field"><label for="name">שם מלא *</label><input id="name" name="name" type="text" required value="<%= values.name || '' %>"></div>
  <div class="field"><label for="phone">טלפון *</label><input id="phone" name="phone" type="tel" required value="<%= values.phone || '' %>"></div>
  <div class="fields two">
    <div class="field"><label for="requested_date">תאריך האירוע</label><input id="requested_date" name="requested_date" type="date" value="<%= values.requested_date || '' %>"></div>
    <div class="field"><label for="event_type">סוג האירוע</label>
      <select id="event_type" name="event_type"><option value=""></option><% L.eventTypes.forEach(function (t) { %><option <%= values.event_type === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
  </div>
  <div class="field"><label for="location">מיקום / אולם (משוער)</label><input id="location" name="location" type="text" value="<%= values.location || '' %>"></div>
  <div class="field"><label for="notes">הערות</label><textarea id="notes" name="notes"><%= values.notes || '' %></textarea></div>
  <button class="btn accent block big">שליחה</button>
</form>
<% } %>
<%- include('../partials/foot', { shell: 'public' }) %>
