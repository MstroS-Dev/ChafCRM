# ───────── Basic
BRAND_NAME=ChafCRM
# Public address of the system (used in WhatsApp links). With a domain: https://crm.example.com
BASE_URL=http://YOUR-EC2-IP:3000
# Long random string. Generate with: openssl rand -hex 32
APP_SECRET=
NODE_ENV=production

# Domain for automatic HTTPS (only when using: docker compose --profile https up -d)
DOMAIN=

# ───────── Manager login (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=מנהל
# Manager's mobile for WhatsApp alerts (new leads, unconfirmed crew)
MANAGER_PHONE=05X-XXXXXXX
# Set to 1 for one restart to reset the manager password to ADMIN_PASSWORD
ADMIN_PASSWORD_RESET=0

# ───────── WhatsApp provider: log | greenapi | twilio
# "log" = nothing is sent, messages only appear in the in-app message log (good for testing)
WHATSAPP_PROVIDER=log
DEFAULT_COUNTRY_CODE=972

# Green API (green-api.com)
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# whatsapp:+14155238886 for WhatsApp, or a plain +1... number for SMS
TWILIO_FROM=

# ───────── Manager alerts channel: whatsapp | telegram
MANAGER_CHANNEL=whatsapp
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───────── Incoming webhooks (Green API / Twilio / Make / Telegram). Generate with: openssl rand -hex 16
WEBHOOK_KEY=

# ───────── Automations
AUTO_REPLY_TO_CLIENT=true
CREATE_LEADS_FROM_WHATSAPP=true
REMINDER_HOURS_BEFORE=24
UNCONFIRMED_ALERT_HOURS=48
